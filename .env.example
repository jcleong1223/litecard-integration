APP_NAME='Litecard Integration'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL='http://oaqms.sgdatahub.net:8282/'
APP_URL=http://litecard-integration.test
APP_DOMAIN='http://litecard-integration.test'

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=litecard_integration
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

SSO_COOKIE_NAME=
JWT_KEY=
AES_IV=
AES_KEY=
AES_ALGO=

QUERY_CACHE_TIME=1800
USER_PREF_CACHE_TIME=86400

# ACTIVITY LOG
ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_TABLE_NAME=activity_log
ACTIVITY_LOGGER_DB_CONNECTION=
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14


SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=


# services
LITECARD_API_BASE_URL=https://bff-api.demo.litecard.io
LITECARD_TIMEOUT=30
LITECARD_MAX_RESPONSE_EXCERPT_BYTES=8192

BACKOFFICE_API_BASE_URL=http://laravel-public-api.test
BACKOFFICE_API_END_POINT_PREFIX=/api/sgmember
BACKOFFICE_API_KEY=
BACKOFFICE_TIMEOUT=300
BACKOFFICE_CACHE_SECONDS=20


SOURCE_CONNECT_TIMEOUT=3
SOURCE_DEFAULT_TIMEOUT=10
SOURCE_MAX_TIMEOUT=30
SOURCE_DEFAULT_MAX_ATTEMPTS=8
SOURCE_ALLOWED_CLOCK_SKEW_SECONDS=300
SOURCE_MAX_PAYLOAD_BYTES=1048576
SOURCE_RESPONSE_EXCERPT_BYTES=8192
SOURCE_REQUIRE_HTTPS=true
SOURCE_ALLOWED_PORTS=443
SOURCE_ALLOW_REDIRECTS=false
SOURCE_WARNING_ATTEMPT=3
SOURCE_DEGRADED_FAILURE_COUNT=10
SOURCE_DOWN_FAILURE_COUNT=20
